# Configuración pública del SDK cliente de Firebase (no son secretas, ver research.md §10).
# Copiar este archivo a .env.local (no versionado) y completar con los valores del proyecto de Firebase.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=

# Si es "true", el SDK se conecta a los emuladores locales de Firestore/Storage/Auth
# en vez del proyecto real (firebase emulators:start --only firestore,storage,auth).
VITE_USE_FIREBASE_EMULATORS=false
